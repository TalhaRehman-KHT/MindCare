# =============================================================
# MindCare — backend environment (Node API + MindAI service)
# Copy to .env and fill in real values. NEVER commit .env.
# =============================================================

# ---------- Server ----------
PORT=4000
# IANA time zone that doctor schedules are interpreted in (slots stored in UTC)
CLINIC_TZ=Asia/Karachi

# ---------- Database (MongoDB Atlas) ----------
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster-host>/<database>

# ---------- Auth ----------
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Hospital admin login for the admin panel
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ---------- Cloudinary (doctor / profile images) ----------
CLOUDINARY_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_SECRET_KEY=your-cloudinary-api-secret

# ---------- Email (Gmail by default) ----------
EMAIL_USER=you@gmail.com
# Gmail App Password (16 chars), NOT your normal password
EMAIL_PASS=your-gmail-app-password
MAIL_FROM_NAME="MindCare"
# Optional reply-to / footer support address
SUPPORT_EMAIL=
# Optional https logo URL used in emails (see scripts/upload-email-logo.mjs)
EMAIL_LOGO_URL=

# ---------- Optional SMTP overrides (leave commented to use Gmail) ----------
# MAIL_SERVICE=gmail
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM_ADDRESS=noreply@your-domain.com

# ---------- App URLs (used in email links / hand-off) ----------
PATIENT_APP_URL=http://localhost:5173
ADMIN_PANEL_URL=http://localhost:5174

# ---------- MindAI (FastAPI + Groq) ----------
# Where the Node API reaches the MindAI service
CHATBOT_URL=http://127.0.0.1:5000
CHATBOT_HOST=127.0.0.1
CHATBOT_PORT=5000
# Seconds to wait for the LLM before failing the request
CHATBOT_LLM_TIMEOUT=45
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
