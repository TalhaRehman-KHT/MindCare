# =============================================================
# MindCare — PRODUCTION secrets for the home server
# Copy to deploy/.env (same folder) and fill in real values:
#   cp .env.example .env && nano .env && chmod 600 .env
# NEVER commit the real .env.
# =============================================================

# ---------- Server ----------
CLINIC_TZ=Asia/Karachi

# ---------- Database (MongoDB Atlas) ----------
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority&appName=Cluster0

# ---------- Auth ----------
# Generate:  openssl rand -hex 48
JWT_SECRET=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ---------- Cloudinary ----------
CLOUDINARY_NAME=dm4yf34no
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=

# ---------- Email (Gmail App Password) ----------
EMAIL_USER=
EMAIL_PASS=
MAIL_FROM_NAME="MindCare"
SUPPORT_EMAIL=
EMAIL_LOGO_URL=

# ---------- Public URLs (used in email links) ----------
PATIENT_APP_URL=https://mindcare.us.ci
ADMIN_PANEL_URL=https://admin.mindcare.us.ci

# ---------- MindAI (FastAPI + Groq) ----------
# CHATBOT_URL is set in docker-compose.yml (http://ai:5000)
CHATBOT_LLM_TIMEOUT=45
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
